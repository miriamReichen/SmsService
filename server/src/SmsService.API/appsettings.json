{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SmsService;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "SmsProvider": {
    "BaseUrl": "http://localhost:5100",
    "TimeoutSeconds": 5
  },
  "MessageProcessing": {
    "PollIntervalSeconds": 2,
    "DeliveryTimeoutMinutes": 2,
    "MaxSendAttempts": 3,
    "RetryDelaysSeconds": [ 1, 2, 4 ]
  },
  "ClientOrigin": "http://localhost:5173"
}
